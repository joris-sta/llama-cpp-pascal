 using json = common_json;
 using namespace common_arg_utils;
 
+std::vector<int32_t> common_parse_kv_q8_layers(const std::string & value) {
+    std::vector<int32_t> layers;
+    std::stringstream input(value);
+    std::string part;
+    if (value.empty() || value.back() == ',') throw std::invalid_argument("--kv-q8-layers: empty layer list or entry");
+    while (std::getline(input, part, ',')) {
+        const auto dash = part.find('-');
+        const auto parse = [](const std::string & s) -> int32_t {
+            if (s.empty() || s.find_first_not_of("0123456789") != std::string::npos)
+                throw std::invalid_argument("--kv-q8-layers: expected nonnegative layer index");
+            const unsigned long n = std::stoul(s);
+            if (n > 65535) throw std::invalid_argument("--kv-q8-layers: layer index exceeds 65535");
+            return int32_t(n);
+        };
+        const int32_t first = parse(part.substr(0, dash));
+        const int32_t last = dash == std::string::npos ? first : parse(part.substr(dash + 1));
+        if (last < first) throw std::invalid_argument("--kv-q8-layers: descending range");
+        for (int32_t il = first; il <= last; ++il) layers.push_back(il);
+    }
+    std::sort(layers.begin(), layers.end());
+    layers.erase(std::unique(layers.begin(), layers.end()), layers.end());
+    return layers;
+}
