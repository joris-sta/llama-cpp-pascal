+bool server_cache_checkpoint_anchor_covered(
+        const common_prompt_checkpoint & previous,
+        const common_prompt_checkpoint & incoming,
+        const common_retention_turn_table & turns,
+        bool earliest) noexcept {
+    if (earliest || !server_cache_checkpoint_bounded_replay(
+            previous, incoming, UINT64_MAX)) {
+        return false;
+    }
+    common_retention_stamp old_score, new_score;
+    if (!common_retention_score(turns, uint64_t(previous.n_tokens), old_score) ||
+        !common_retention_score(turns, uint64_t(incoming.n_tokens), new_score)) {
+        return false;
+    }
+    return !old_score.mandatory_anchor ||
+           old_score.mapped_turn_ordinal == new_score.mapped_turn_ordinal;
+}
