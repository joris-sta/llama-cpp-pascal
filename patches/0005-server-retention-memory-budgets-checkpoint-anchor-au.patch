+static void test_closed_prefill_cancels_forced_message() {
+    // Thinking-off templates prefill an empty, already closed block. With a
+    // zero budget, accepting the start tag enters FORCING before that closing
+    // tag is consumed. A long forced message must not leak into generation.
+    for (const auto & end : std::vector<llama_tokens>{{101}, {101, 102}}) {
+        llama_tokens forced = {110, 111, 112, 113, 114, 115, 116};
+        forced.insert(forced.end(), end.begin(), end.end());
+        auto * sampler = common_reasoning_budget_init(nullptr, {{100}}, {end}, forced, 0, REASONING_BUDGET_IDLE);
+        llama_sampler_accept(sampler, 100);
+        llama_sampler_accept(sampler, 50); // prefilled newline
+        for (auto token : end) llama_sampler_accept(sampler, token);
+        GGML_ASSERT(common_reasoning_budget_get_state(sampler) == REASONING_BUDGET_DONE);
+        llama_sampler_accept(sampler, 51); // final-answer prefix
+        GGML_ASSERT(common_reasoning_budget_get_state(sampler) == REASONING_BUDGET_DONE);
+        llama_sampler_free(sampler);
+    }
+}
