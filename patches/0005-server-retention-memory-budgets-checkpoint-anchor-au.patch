+void test_checkpoint_incoming_anchor_coverage() {
+    common_retention_turn_table turns;
+    turns.source = common_retention_source_state::known;
+    turns.token_count = 500;
+    turns.boundaries = { { 0, 0, 50 }, { 1, 100, 200 }, { 2, 300, 400 } };
+    CHECK(turns.valid());
+    const auto checkpoint = [](int64_t tokens) {
+        common_prompt_checkpoint result;
+        result.n_tokens = tokens;
+        auto & frontier = result.computation_frontier;
+        frontier.version = common_computation_frontier::VERSION;
+        frontier.sequence_epoch = 1;
+        frontier.token_count = tokens;
+        frontier.next_position = tokens;
+        frontier.execution_identity = "execution";
+        frontier.adapter_config_identity = "adapter";
+        frontier.media_content_identity = "media";
+        return result;
+    };
+    const auto incoming = checkpoint(480);
+    CHECK(server_cache_checkpoint_anchor_covered(checkpoint(350), incoming, turns, false));
+    CHECK(server_cache_checkpoint_anchor_covered(checkpoint(160), incoming, turns, false));
+    CHECK(!server_cache_checkpoint_anchor_covered(checkpoint(350), incoming, turns, true));
+    CHECK(!server_cache_checkpoint_anchor_covered(checkpoint(50), incoming, turns, false));
+    CHECK(!server_cache_checkpoint_anchor_covered(checkpoint(490), incoming, turns, false));
+    auto other = checkpoint(350);
+    other.computation_frontier.sequence_epoch++;
+    CHECK(!server_cache_checkpoint_anchor_covered(other, incoming, turns, false));
+    other = checkpoint(350);
+    other.computation_frontier.execution_identity = "different execution";
+    CHECK(!server_cache_checkpoint_anchor_covered(other, incoming, turns, false));
+    turns.source = common_retention_source_state::unavailable;
+    CHECK(!server_cache_checkpoint_anchor_covered(checkpoint(350), incoming, turns, false));
+}
