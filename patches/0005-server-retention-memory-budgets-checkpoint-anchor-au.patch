+static uint64_t directory_bytes(const std::string & root) {
+    std::error_code ec;
+    uint64_t bytes = 0;
+    for (fs::recursive_directory_iterator it(root, ec), end; !ec && it != end; it.increment(ec)) {
+        // Do not follow symlinks, including a symlink to a regular file outside the cache.
+        if (fs::is_regular_file(it->symlink_status(ec))) {
+            const uint64_t size = it->file_size(ec);
+            if (ec || size > UINT64_MAX - bytes) { return UINT64_MAX; }
+            bytes += size;
+        }
+    }
+    return ec ? UINT64_MAX : bytes;
+}
+
+void server_resume_store::set_budget(const std::string & root, uint64_t max_bytes) {
+    budget_root = root.empty() ? dir : root;
+    budget_bytes = max_bytes;
+}
+
+bool server_resume_store::make_room(uint64_t required, const std::set<std::string> & protected_ids,
+                                   const std::set<std::string> & preferred_ids) const {
+    if (!budget_bytes) { return true; }
+    // An unreadable budget root is not evidence that any entry should be evicted.
+    if (directory_bytes(budget_root) == UINT64_MAX) { return false; }
+    const auto fits = [&]() {
+        const uint64_t used = directory_bytes(budget_root);
+        return used <= budget_bytes && required <= budget_bytes - used;
+    };
+    if (required > budget_bytes) { return false; }
+    if (fits()) { return true; }
+    auto entries = list(); // newest first
+    std::reverse(entries.begin(), entries.end());
+    std::stable_sort(entries.begin(), entries.end(), [&](const server_resume_entry & a, const server_resume_entry & b) {
+        return preferred_ids.count(a.id) < preferred_ids.count(b.id);
+    });
+    for (const auto & entry : entries) {
+        if (protected_ids.count(entry.id)) { continue; }
+        remove_entry(entry.id);
+        if (fits()) { return true; }
+    }
+    return false;
+}
+
 uint64_t server_resume_store::free_bytes() const {
     struct statvfs vfs;
     if (statvfs(dir.c_str(), &vfs) != 0) {
         return 0;
     }
-    return (uint64_t) vfs.f_bavail * vfs.f_frsize;
+    const uint64_t available = (uint64_t) vfs.f_bavail * vfs.f_frsize;
+    if (!budget_bytes) { return available; }
+    const uint64_t used = directory_bytes(budget_root);
+    return std::min(available, used >= budget_bytes ? uint64_t(0) : budget_bytes - used);
 }
 
