+static void test_disk_budget(const std::string & root) {
+    server_resume_reason reason;
+    std::string error;
+    auto store = server_resume_store::open(root, FAMILY, reason, error);
+    CHECK(store != nullptr);
+    if (!store) { return; }
+    const auto bytes = [](const std::string & path) {
+        uint64_t total = 0;
+        for (const auto & file : fs::recursive_directory_iterator(path)) {
+            if (fs::is_regular_file(file.symlink_status())) { total += file.file_size(); }
+        }
+        return total;
+    };
+    const std::string older = server_resume_store::new_entry_id();
+    const std::string newer = server_resume_store::new_entry_id();
+    auto old = manifest_of(16, 0);
+    auto fresh = manifest_of(16, 0);
+    old.last_used_unix_ms = 100;
+    fresh.last_used_unix_ms = 200;
+    CHECK(add_generation(*store, older, old, 0, 16) == server_resume_reason::ok);
+    CHECK(add_generation(*store, newer, fresh, 0, 16) == server_resume_reason::ok);
+    // External Pi snapshots count against the same budget, but only the native
+    // writer's own entries are removable. The newest entry can be protected.
+    const std::string external = root + "/pi-snapshot.bin";
+    { std::ofstream out(external); out << std::string(512, 'x'); }
+    const uint64_t cap = bytes(root) - bytes(store->directory() + "/entries/" + older) + 64;
+    store->set_budget(root, cap);
+    CHECK(store->make_room(64, {newer}));
+    CHECK(!fs::exists(store->directory() + "/entries/" + older));
+    CHECK(fs::exists(store->directory() + "/entries/" + newer));
+    CHECK(fs::exists(external));
+    CHECK(store->free_bytes() == 64);
+    CHECK(!store->make_room(cap + 1)); // an impossible save does not evict useful entries
+    CHECK(fs::exists(store->directory() + "/entries/" + newer));
+    store->set_budget(root, 256);
+    CHECK(!store->make_room(0, {newer}));
+    CHECK(fs::exists(external));
+    CHECK(store->free_bytes() == 0);
+    CHECK(!store->make_room(0)); // external file alone is over budget
+    CHECK(!fs::exists(store->directory() + "/entries/" + newer));
+    store->set_budget(root, 0);
+    CHECK(store->free_bytes() > 0);
+}
+
