+            maximum[h] = next;
+            denominator[h] = fmaf(denominator[h],rescale,weight);
+#pragma unroll
+            for (int j = 0; j < J; ++j) output[h][j] = fmaf(value[j],weight,output[h][j]*rescale);
+        }
