+#pragma unroll
+            for (int j = 0; j < J; ++j) score = fmaf(query[h][j],key[j],score);
+#pragma unroll
+            for (int offset = 16; offset > 0; offset /= 2) score += __shfl_xor_sync(0xffffffffu,score,offset);
