+// Diagnostic timings are opt-in and deliberately synchronize each operation.
+// Disable regular AND step graphs when profiling; captured/replayed nodes
+// cannot provide individual timings through this eager evaluator.
+struct ggml_cuda_op_profile {
+    struct events {
+        cudaEvent_t start = nullptr, stop = nullptr;
+        events() { CUDA_CHECK(cudaEventCreate(&start)); CUDA_CHECK(cudaEventCreate(&stop)); }
+        ~events() { (void) cudaEventDestroy(start); (void) cudaEventDestroy(stop); }
+    };
+    events * timer = nullptr;
+    cudaStream_t stream = nullptr;
+    const ggml_tensor * node = nullptr;
+    ggml_cuda_op_profile(ggml_backend_cuda_context & ctx, const ggml_tensor * dst) {
+        static const bool enabled = [] {
+            const char * value = getenv("GGML_CUDA_PROFILE_OPS");
+            return value && atoi(value) != 0;
+        }();
+        if (!enabled) return;
+        cudaStreamCaptureStatus status;
+        CUDA_CHECK(cudaStreamIsCapturing(ctx.stream(), &status));
+        if (status != cudaStreamCaptureStatusNone || ctx.external_capture) return;
+        static thread_local std::unordered_map<int, std::unique_ptr<events>> cache;
+        auto & entry = cache[ctx.device];
+        if (!entry) entry.reset(new events);
+        timer = entry.get(); stream = ctx.stream(); node = dst;
+        CUDA_CHECK(cudaEventRecord(timer->start, stream));
+    }
+    ~ggml_cuda_op_profile() {
+        if (!timer) return;
+        CUDA_CHECK(cudaEventRecord(timer->stop, stream));
+        CUDA_CHECK(cudaEventSynchronize(timer->stop));
+        float ms = 0;
+        CUDA_CHECK(cudaEventElapsedTime(&ms, timer->start, timer->stop));
+        fprintf(stderr, "CUDA_OP_PROFILE op=%s name=%s ne1=%lld kv=%lld ms=%.6f\n",
+                ggml_op_name(node->op), node->name, (long long) node->ne[1],
+                (long long) (node->src[1] ? node->src[1]->ne[1] : 0), ms);
+    }
+};
