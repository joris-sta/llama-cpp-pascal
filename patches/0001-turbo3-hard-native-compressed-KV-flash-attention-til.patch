+// Decode compressed Turbo3 rows only when the attention tile consumes them.
+// For 6:1 GQA this lets one CTA share each decoded KV row across six queries.
+template <int nwarps, int I, int J, int J_padding, bool oob_check, bool is_value, typename T>
+static __device__ __forceinline__ void flash_attn_tile_load_turbo3(
+        const char * __restrict__ raw, T * __restrict__ tile,
+        const int stride_bytes, const int i_sup, const int j_offset) {
+    const int tid = threadIdx.y * 32 + threadIdx.x;
+#ifdef FAST_FP16_AVAILABLE
+    constexpr int cols = J / 2;
+#else
+    constexpr int cols = J;
+#endif
+    for (int idx = tid; idx < I * cols; idx += nwarps * 32) {
+        const int row = idx / cols;
+        const int col = idx % cols;
+#ifdef FAST_FP16_AVAILABLE
+        const int j = j_offset + 2 * col;
+#else
+        const int j = j_offset + col;
+#endif
+        float x = 0.0f;
+        float y = 0.0f;
+        if (!oob_check || row < i_sup) {
+            const block_turbo3_0 * blocks = (const block_turbo3_0 *) (raw + (int64_t) row * stride_bytes);
+            const block_turbo3_0 & block = blocks[j / QK_TURBO3];
+            const int p = j % QK_TURBO3;
+            const float norm = __half2float(block.norm);
+            const int ix = ((block.qs[p / 4] >> (2 * (p % 4))) & 3) |
+                           (((block.signs[p / 8] >> (p % 8)) & 1) << 2);
+            x = d_turbo_centroids_3bit_fattn[ix] * norm;
+#if TURBO3_SKEW_EXP >= 2
+            x *= is_value ? d_turbo3_ss_v_fattn[j % 128] : d_turbo3_ss_k_fattn[j % 128];
+#endif
+#ifdef FAST_FP16_AVAILABLE
+            const int p1 = p + 1;
+            const int iy = ((block.qs[p1 / 4] >> (2 * (p1 % 4))) & 3) |
+                           (((block.signs[p1 / 8] >> (p1 % 8)) & 1) << 2);
+            y = d_turbo_centroids_3bit_fattn[iy] * norm;
+#if TURBO3_SKEW_EXP >= 2
+            y *= is_value ? d_turbo3_ss_v_fattn[(j + 1) % 128] : d_turbo3_ss_k_fattn[(j + 1) % 128];
+#endif
+#endif
+        }
+#ifdef FAST_FP16_AVAILABLE
+        tile[row * (cols + J_padding) + col] = make_half2(x, y);
+#else
+        tile[row * (cols + J_padding) + col] = x;
+#endif
+    }
+}
