index 6c8181a70..deda5a386 100644
--- a/ggml/src/ggml-cuda/gated_delta_net.cu
+++ b/ggml/src/ggml-cuda/gated_delta_net.cu
@@ -1,5 +1,6 @@
 #include "gated_delta_net.cuh"
 #include "gdn-norm.cuh"
+#include "gdn-chunk-pascal.cuh"
 #include "gated_delta_net_fla_ptx.cuh"
 #include "ggml-cuda/common.cuh"
 
@@ -211,6 +212,105 @@ gated_delta_net_cuda(const float * q,
