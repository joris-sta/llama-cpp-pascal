+
+#if !defined(GGML_USE_HIP) && !defined(GGML_USE_MUSA)
+// Chunk-staged recurrent FP32 path for pre-tensor-core GPUs. Each warp reuses
+// normalized Q/K across C value columns. Token tiles amortize global input
+// loads across the CTA while preserving the exact recurrent/snapshot order.
+template<int D, int C, int Tile, bool Keep, bool SumEps>
+__global__ __launch_bounds__(128,2) void gated_delta_net_pascal(
+        const float * q, const float * k, const float * v, const float * g,
+        const float * beta, const float * curr_state, float * dst, float * state,
+        int64_t H, int64_t n_tokens, int64_t n_seqs,
+        int64_t sq1, int64_t sq2, int64_t sq3,
+        int64_t sv1, int64_t sv2, int64_t sv3,
+        int64_t sb1, int64_t sb2, int64_t sb3,
+        uint3 neqk1_magic, uint3 rq3_magic, float scale, int64_t state_slot_stride,
+        int K, ggml_cuda_gdn_norm norm, const int32_t * input_rows) {
+    GGML_UNUSED_VARS(n_seqs,input_rows);
+    constexpr int R = D/32, Columns = 4*C;
+    const int lane = threadIdx.x, warp = threadIdx.y, tid = warp*32+lane;
+    const int head = blockIdx.x, seq = blockIdx.y, col0 = blockIdx.z*Columns+warp*C;
+    const int qhead = fastmodulo(head,neqk1_magic), qseq = fastdiv(seq,rq3_magic);
+    const int64_t state_base = (int64_t(seq)*H+head)*D*D;
+    float shard[C][R];
+#pragma unroll
+    for (int c = 0; c < C; ++c) {
+#pragma unroll
+        for (int r = 0; r < R; ++r) shard[c][r] = curr_state[state_base+(col0+c)*D+lane+32*r];
+    }
+    __shared__ float qs[Tile][D], ks[Tile][D], vs[Tile][Columns];
+    __shared__ float gs[Tile], bs[Tile];
+    for (int t0 = 0; t0 < n_tokens; t0 += Tile) {
+        const int count = int(n_tokens-t0) < Tile ? int(n_tokens-t0) : Tile;
+        for (int i = tid; i < count*D; i += 128) {
+            const int t = i/D, j = i%D;
+            qs[t][j] = q[qseq*sq3+(t0+t)*sq2+qhead*sq1+j];
+            ks[t][j] = k[qseq*sq3+(t0+t)*sq2+qhead*sq1+j];
+        }
+        for (int i = tid; i < count*Columns; i += 128) {
+            const int t = i/Columns, c = i%Columns;
+            vs[t][c] = v[seq*sv3+(t0+t)*sv2+head*sv1+blockIdx.z*Columns+c];
+        }
+        if (tid < count) {
+            const int64_t offset = seq*sb3+(t0+tid)*sb2+head*sb1;
+            gs[tid] = GDN_EXPF(g[offset]); bs[tid] = beta[offset];
+        }
+        __syncthreads();
+        for (int t = 0; t < count; ++t) {
+            float qr[R], kr[R];
+#pragma unroll
+            for (int r = 0; r < R; ++r) { qr[r]=qs[t][lane+32*r]; kr[r]=ks[t][lane+32*r]; }
+            if (SumEps || norm.eps >= 0.0f) {
+                float qq = 0, kk = 0;
+#pragma unroll
+                for (int r = 0; r < R; ++r) { qq += qr[r]*qr[r]; kk += kr[r]*kr[r]; }
+                qq = warp_reduce_sum<32>(qq); kk = warp_reduce_sum<32>(kk);
+                const float qscale = SumEps ? rsqrtf(qq+norm.eps) : norm.inverse(qq,D);
+                const float kscale = SumEps ? rsqrtf(kk+norm.eps) : norm.inverse(kk,D);
+#pragma unroll
+                for (int r = 0; r < R; ++r) {
+                    qr[r] = SumEps ? qr[r]*qscale : norm.apply(qr[r],qscale);
+                    kr[r] = SumEps ? kr[r]*kscale : norm.apply(kr[r],kscale);
+                }
+            }
+#pragma unroll
+            for (int c = 0; c < C; ++c) {
+                float product = 0;
+#pragma unroll
+                for (int r = 0; r < R; ++r) product += shard[c][r]*kr[r];
+                product = warp_reduce_sum<32>(product);
+                const float delta = (vs[t][warp*C+c]-gs[t]*product)*bs[t];
+                float result = 0;
+#pragma unroll
+                for (int r = 0; r < R; ++r) {
+                    shard[c][r] = gs[t]*shard[c][r]+kr[r]*delta;
+                    result += shard[c][r]*qr[r];
+                }
+                result = warp_reduce_sum<32>(result);
+                if (lane == 0) dst[(int64_t(seq)*n_tokens*H+(t0+t)*H+head)*D+col0+c] = result*scale;
+                if constexpr (Keep) {
+                    const int slot = int(n_tokens)-1-(t0+t);
+                    if (slot < K) {
+#pragma unroll
+                        for (int r = 0; r < R; ++r)
+                            state[slot*state_slot_stride+state_base+(col0+c)*D+lane+32*r] = shard[c][r];
+                    }
+                }
+            }
+        }
+        __syncthreads();
+    }
+    if constexpr (!Keep) {
+#pragma unroll
+        for (int c = 0; c < C; ++c) {
+#pragma unroll
+            for (int r = 0; r < R; ++r) state[state_base+(col0+c)*D+lane+32*r] = shard[c][r];
+        }
+    }
+}
+#endif
+
 template <bool KDA, bool keep_rs_t>
 static void launch_gated_delta_net(
         const float * q_d, const float * k_d, const float * v_d,
@@ -223,7 +323,7 @@ static void launch_gated_delta_net(
         int64_t neqk1, int64_t rq3,
         float scale, int64_t state_slot_stride, int K, ggml_cuda_gdn_norm l2_norm, cudaStream_t stream,
         const int32_t * input_rows = nullptr) {
-    //TODO: Add chunked kernel for even faster pre-fill
+    // Recurrent fallback for decode, unsupported shapes and explicit staged comparisons.
     const int warp_size = ggml_cuda_info().devices[ggml_cuda_get_device()].warp_size;
     const int num_warps = 4;
     dim3      grid_dims(H, n_seqs, (S_v + num_warps - 1) / num_warps);
@@ -236,6 +336,35 @@ static void launch_gated_delta_net(
     // Select canonical normalization once, outside the recurrent token loop.
     const auto launch = [&](auto sum_eps_tag) {
         constexpr bool sum_eps_t = decltype(sum_eps_tag)::value;
+#if !defined(GGML_USE_HIP) && !defined(GGML_USE_MUSA)
+        static const int staged = [] {
+            const char * value = getenv("GGML_CUDA_GDN_PASCAL");
+            if (!value || strcmp(value,"auto") == 0) return 0;
+            if (strcmp(value,"off") == 0) return -1;
+            if (strcmp(value,"staged") == 0) return 1;
+            GGML_ABORT("GGML_CUDA_GDN_PASCAL must be auto, off or staged");
+        }();
+        if constexpr (!KDA) {
+            // Width 64 regressed in the measured sweep; width 32 gains were
+            // marginal. Keep automatic selection on the robust width-128 win.
+            const bool automatic = S_v == 128 && n_tokens >= 64;
+            if (staged >= 0 && (staged == 1 || automatic) && !input_rows && n_tokens >= 16 &&
+                ggml_cuda_info().devices[ggml_cuda_get_device()].cc == 610) {
+                const auto parameters = ggml_cuda_kernel_launch_params(dim3(H,n_seqs,S_v/16),dim3(32,4),0,stream);
+#define GDN_STAGE(D) ggml_cuda_kernel_launch(gated_delta_net_pascal<D,4,16,keep_rs_t,sum_eps_t>,parameters, \
+                    q_d,k_d,v_d,g_d,b_d,s_d,dst_d,state_d,H,n_tokens,n_seqs, \
+                    sq1,sq2,sq3,sv1,sv2,sv3,sb1,sb2,sb3,neqk1_magic,rq3_magic, \
+                    scale,state_slot_stride,K,l2_norm,input_rows)
+                switch (S_v) {
+                    case 32: GDN_STAGE(32); return;
+                    case 64: GDN_STAGE(64); return;
+                    case 128: GDN_STAGE(128); return;
+                    default: break;
+                }
+#undef GDN_STAGE
+            }
+        }
+#endif
         switch (S_v) {
             case 16:
                 ggml_cuda_kernel_launch(gated_delta_net_cuda<16, KDA, keep_rs_t, sum_eps_t>, launch_params,
@@ -379,6 +508,51 @@ static void ggml_cuda_op_gated_delta_net_impl(
         state_slot_stride = cache->slot_stride;
     }
 
+#if !defined(GGML_USE_HIP) && !defined(GGML_USE_MUSA)
+    static const int chunk_policy = [] {
+        const char * value = getenv("GGML_CUDA_GDN_PASCAL_CHUNK");
+        if (!value || strcmp(value, "auto") == 0) return -1;
+        if (strcmp(value, "off") == 0) return 0;
+        if (strcmp(value, "16") == 0) return 16;
+        if (strcmp(value, "32") == 0) return 32;
+        GGML_ABORT("GGML_CUDA_GDN_PASCAL_CHUNK must be auto, off, 16 or 32");
+    }();
+    // Whole-graph measurements include canonical deferred normalization.
+    // Timing repeated GDN nodes alone amortizes it away and selects the wrong
+    // algorithm. C16 wins on the tested 32/48-value-head canonical graphs;
+    // retain the staged recurrence for already-normalized and small-head inputs.
+    const int chunk_size = chunk_policy < 0 ?
+        (l2_norm.sum_eps && H >= 32 && n_tokens >= 64 && !keep_rs ? 16 : 0) : chunk_policy;
+    if (chunk_size && ggml_cuda_info().devices[ctx.device].cc == 610 &&
+        !kda && !input_rows && S_v == 128 && n_tokens >= 16) {
+        const auto chunk_launch = [&](auto chunk_tag, auto norm_tag, auto keep_tag) {
+            constexpr int C = decltype(chunk_tag)::value;
+            constexpr bool SumEps = decltype(norm_tag)::value;
+            constexpr bool Keep = decltype(keep_tag)::value;
+            const int chunks = (n_tokens+C-1)/C;
+            ggml_cuda_pool_alloc<float> workspace(ctx.pool(), size_t(H)*n_seqs*chunks*gdn_chunk_layout<C>::floats);
+            ggml_cuda_kernel_launch(gdn_chunk_prepare<C,SumEps>,
+                ggml_cuda_kernel_launch_params(dim3(H,n_seqs,chunks),dim3(128),0,stream),
+                q_d,k_d,v_d,g_d,b_d,workspace.get(),int(H),int(n_tokens),chunks,
+                sq1,sq2,sq3,sv1,sv2,sv3,sb1,sb2,sb3,init_fastdiv_values(neqk1),init_fastdiv_values(rq3),l2_norm);
+            ggml_cuda_kernel_launch(gdn_chunk_apply<C,16,Keep>,
+                ggml_cuda_kernel_launch_params(dim3(H,n_seqs,8),dim3(128),0,stream),
+                workspace.get(),s_d,dst_d,state_d,int(H),int(n_tokens),chunks,state_slot_stride,K,scale);
+        };
+        const auto chunk_norm = [&](auto c) {
+            if (l2_norm.sum_eps) {
+                if (keep_rs) chunk_launch(c,std::true_type{},std::true_type{});
+                else chunk_launch(c,std::true_type{},std::false_type{});
+            } else {
+                if (keep_rs) chunk_launch(c,std::false_type{},std::true_type{});
+                else chunk_launch(c,std::false_type{},std::false_type{});
+            }
+        };
+        if (chunk_size == 16) chunk_norm(std::integral_constant<int,16>{});
+        else chunk_norm(std::integral_constant<int,32>{});
+        return;
+    }
+#endif
     const int cc = ggml_cuda_info().devices[ctx.device].cc;
     if (!input_rows && ggml_cuda_gdn_fla_ptx_supported(cc, kda, keep_rs, S_v, H, neqk1, n_tokens, n_seqs)) {
         ggml_cuda_gdn_fla_ptx(ctx, cc, q_d, k_d, v_d, g_d, b_d, s_d, dst_d, state_d,
diff --git a/ggml/src/ggml-cuda/gdn-chunk-pascal.cuh b/ggml/src/ggml-cuda/gdn-chunk-pascal.cuh
new file mode 100644
index 000000000..5314559d9
--- /dev/null
+++ b/ggml/src/ggml-cuda/gdn-chunk-pascal.cuh
@@ -0,0 +1,258 @@
+#pragma once
+
+#include "gdn-norm.cuh"
+
+// Scalar-gate DeltaNet, C-token WY/UT prefill, independently derived from
+// S_i = exp(g_i) S_{i-1} + k_i beta_i (v_i - exp(g_i) k_i^T S_{i-1}).
+// L_ij = beta_i exp(sum_{j<u<=i} g_u) k_i^T k_j, j<i;
+// T=(I+L)^-1; W=T diag(beta*G) K; U=T diag(beta) V.
+// Delta=T(beta V-beta G K S_in); O=G Q S_in+A Delta;
+// S_out=G_last S_in+K^T D_last Delta (implicit WY, materialized UT).
+// No inverse cumulative gate: negative/reset gates can underflow safely.
+// Only the small triangular transform is sequential; the D x D state advances
+// once per chunk. FP32 throughout; no tensor cores or model-name dispatch.
+
+#if !defined(GGML_USE_HIP) && !defined(GGML_USE_MUSA)
+template<int C> struct gdn_chunk_layout {
+    static constexpr int D = 128;
+    static constexpr int matrix = C*D;
+    static constexpr int floats = 4*matrix + 3*C*C + C;
+    float * q; float * k; float * w; float * u;
+    float * a; float * decay; float * prefix; float * triangular;
+    __host__ __device__ explicit gdn_chunk_layout(float * p) :
+        q(p), k(p+matrix), w(p+2*matrix), u(p+3*matrix),
+        a(p+4*matrix), decay(a+C*C), prefix(decay+C*C), triangular(prefix+C) {}
+};
+
+__device__ __forceinline__ float gdn_chunk_exp(float x) {
+    return exp2f(x*1.442695041f);
+}
+
+template<int C, bool SumEps>
+static __global__ void __launch_bounds__(128, 2) gdn_chunk_prepare(
+        const float * q, const float * k, const float * v, const float * g, const float * beta,
+        float * work, int H, int tokens, int chunks,
+        int64_t sq1, int64_t sq2, int64_t sq3, int64_t sv1, int64_t sv2, int64_t sv3,
+        int64_t sb1, int64_t sb2, int64_t sb3, uint3 head_magic, uint3 seq_magic,
+        ggml_cuda_gdn_norm norm) {
+    constexpr int D=128;
+    const int head=blockIdx.x, seq=blockIdx.y, chunk=blockIdx.z;
+    const int tid=threadIdx.x, lane=tid%32, warp=tid/32;
+    const int start=chunk*C, count=min(C,tokens-start);
+    const int qh=fastmodulo(head,head_magic), qs=fastdiv(seq,seq_magic);
+    gdn_chunk_layout<C> out(work+((size_t(seq)*H+head)*chunks+chunk)*gdn_chunk_layout<C>::floats);
+    // 29,696 B C32; pad key rows to avoid shared-bank conflicts in UT GEMMs.
+    __shared__ float keys[C][D+1], inverse[C][C+1], attention[C][C+1];
+    __shared__ float gates[C], betas[C], prefix[C], row[C], decay_matrix[C][C+1];
+    ggml_cuda_pdl_sync();
+    for (int t=tid; t<C; t+=128) {
+        const int64_t gb=seq*sb3+(start+t)*sb2+head*sb1;
+        gates[t]=t<count ? gdn_chunk_exp(g[gb]) : 1.0f;
+        betas[t]=t<count ? beta[gb] : 0.0f;
+    }
+    __syncthreads();
+    for (int t=warp;t<C;t+=4) {
+        float qr[4], kr[4], qsum=0, ksum=0;
+#pragma unroll
+        for(int r=0;r<4;++r) {
+            const int i=lane+32*r;
+            qr[r]=t<count ? q[qs*sq3+(start+t)*sq2+qh*sq1+i] : 0.0f;
+            kr[r]=t<count ? k[qs*sq3+(start+t)*sq2+qh*sq1+i] : 0.0f;
+            qsum=fmaf(qr[r],qr[r],qsum); ksum=fmaf(kr[r],kr[r],ksum);
+        }
+        if(SumEps || norm.eps>=0) {
+            qsum=warp_reduce_sum(qsum); ksum=warp_reduce_sum(ksum);
+            const float qi=SumEps ? rsqrtf(qsum+norm.eps) : norm.inverse(qsum,D);
+            const float ki=SumEps ? rsqrtf(ksum+norm.eps) : norm.inverse(ksum,D);
+#pragma unroll
+            for(int r=0;r<4;++r) {
+                qr[r]=SumEps ? qr[r]*qi : norm.apply(qr[r],qi);
+                kr[r]=SumEps ? kr[r]*ki : norm.apply(kr[r],ki);
+                // A padded zero token must remain zero even with eps=0.
+                if(t>=count) qr[r]=kr[r]=0;
+            }
+        }
+#pragma unroll
+        for(int r=0;r<4;++r) {
+            const int i=lane+32*r;
+            out.q[t*D+i]=qr[r]; keys[t][i]=kr[r]; out.k[t*D+i]=kr[r];
+        }
+        if(lane==0) {
+            float product=1;
+            for(int u=0;u<=t;++u) product*=gates[u];
+            out.prefix[t]=prefix[t]=product;
+        }
+    }
+    __syncthreads();
+    if(tid<C) {
+        float product=1;
+        for(int j=tid;j>=0;--j) {
+            out.decay[tid*C+j]=decay_matrix[tid][j]=product;
+            product*=gates[j];
+        }
+        for(int j=tid+1;j<C;++j) out.decay[tid*C+j]=decay_matrix[tid][j]=0;
+    }
+    __syncthreads();
+    // Keep the query and current key in registers across a complete causal row.
+    // Each warp's four feature fragments are reused instead of reloading them
+    // for every pair. The gate products were computed once above.
+    for(int i=warp;i<C;i+=4) {
+        float qi[4],ki[4];
+#pragma unroll
+        for(int r=0;r<4;++r) { qi[r]=out.q[i*D+lane+32*r]; ki[r]=keys[i][lane+32*r]; }
+        for(int j=0;j<C;++j) {
+            float kk=0,qk=0;
+            if(j<=i) {
+#pragma unroll
+                for(int r=0;r<4;++r) {
+                    const float kj=keys[j][lane+32*r];
+                    kk=fmaf(ki[r],kj,kk); qk=fmaf(qi[r],kj,qk);
+                }
+                kk=warp_reduce_sum(kk); qk=warp_reduce_sum(qk);
+            }
+            if(lane==0) {
+                const float decay=decay_matrix[i][j];
+                inverse[i][j]=j<i ? betas[i]*decay*kk : (j==i ? 1.0f : 0.0f);
+                attention[i][j]=decay*qk;
+            }
+        }
+    }
+    __syncthreads();
+    // Forward substitution for the unit-lower triangular inverse. Cache the
+    // original L row before overwriting it; all inverse columns run in parallel.
+    for(int i=1;i<C;++i) {
+        if(tid<i) row[tid]=inverse[i][tid];
+        __syncthreads();
+        if(tid<i) {
+            float acc=0;
+            for(int j=tid;j<i;++j) acc=fmaf(row[j],inverse[j][tid],acc);
+            inverse[i][tid]=-acc;
+        }
+        __syncthreads();
+    }
+    // Apply UT to the value-sized residual in the state kernel, rather than
+    // materializing both W=T beta G K and U=T beta V here. This saves one
+    // triangular CxCxD product and keeps the same chunkwise algebra.
+    for(int e=tid;e<C*D;e+=128) {
+        const int i=e/D, d=e%D;
+        out.w[e]=keys[i][d]*(betas[i]*prefix[i]);
+        out.u[e]=i<count ? __ldg(v+seq*sv3+(start+i)*sv2+head*sv1+d)*betas[i] : 0;
+    }
+    for(int e=tid;e<C*C;e+=128) {
+        out.a[e]=attention[e/C][e%C]; out.triangular[e]=inverse[e/C][e%C];
+    }
+    ggml_cuda_pdl_lc();
+}
+
+// SIMT matrix products: adjacent threads own adjacent value columns. A
+// key-major shared state and padded operand tiles provide broadcast/coalesced
+// shared reads. Each lane accumulates several columns, without register copies
+// of the entire state. Token rows are computed in parallel within the chunk.
+template<int C, int Columns=16, bool Keep=false, int TileK=(C==16 ? 64 : 32)>
+static __global__ void __launch_bounds__(128, 4) gdn_chunk_apply(
+        const float * work, const float * input, float * dst, float * states,
+        int H, int tokens, int chunks, int64_t slot_stride, int snapshots, float scale) {
+    constexpr int D=128, Parts=128/C, Acc=Columns/Parts;
+    static_assert(D%TileK==0 && Columns==16,"Pascal SIMT matrix tile");
+    const int tid=threadIdx.x, head=blockIdx.x, seq=blockIdx.y, col0=blockIdx.z*Columns;
+    const int t=tid/Parts, part=tid%Parts;
+    const size_t state_base=(size_t(seq)*H+head)*D*D;
+    __shared__ float state[D][Columns+1], mk[C][TileK+1], mq[C][TileK+1];
+    __shared__ float residual[C][Columns+1], delta[C][Columns+1], coeff[C][C+1], prefix[C];
+    ggml_cuda_pdl_sync();
+    for(int e=tid;e<Columns*D;e+=128) state[e%D][e/D]=input[state_base+(col0+e/D)*D+e%D];
+    __syncthreads();
+    for(int chunk=0;chunk<chunks;++chunk) {
+        const int start=chunk*C, count=min(C,tokens-start);
+        gdn_chunk_layout<C> p(const_cast<float *>(work)+((size_t(seq)*H+head)*chunks+chunk)*gdn_chunk_layout<C>::floats);
+        float d[Acc]={},o[Acc]={};
+        for(int k0=0;k0<D;k0+=TileK) {
+            for(int e=tid;e<C*TileK;e+=128) {
+                mk[e/TileK][e%TileK]=__ldg(p.w+(e/TileK)*D+k0+e%TileK);
+                mq[e/TileK][e%TileK]=__ldg(p.q+(e/TileK)*D+k0+e%TileK);
+            }
+            __syncthreads();
+#pragma unroll 4
+            for(int k=0;k<TileK;++k) {
+                const float w=mk[t][k],q=mq[t][k];
+#pragma unroll
+                for(int a=0;a<Acc;++a) {
+                    const float s=state[k0+k][part+a*Parts];
+                    d[a]=fmaf(w,s,d[a]); o[a]=fmaf(q,s,o[a]);
+                }
+            }
+            __syncthreads();
+        }
+#pragma unroll
+        for(int a=0;a<Acc;++a) residual[t][part+a*Parts]=__ldg(p.u+t*D+col0+part+a*Parts)-d[a];
+        for(int e=tid;e<C*C;e+=128) coeff[e/C][e%C]=__ldg(p.triangular+e);
+        if(tid<C) prefix[tid]=__ldg(p.prefix+tid);
+        __syncthreads();
+        float solved[Acc]={};
+        for(int j=0;j<=t;++j) {
+            const float a=coeff[t][j];
+#pragma unroll
+            for(int c=0;c<Acc;++c) solved[c]=fmaf(a,residual[j][part+c*Parts],solved[c]);
+        }
+#pragma unroll
+        for(int c=0;c<Acc;++c) delta[t][part+c*Parts]=solved[c];
+        __syncthreads();
+        for(int e=tid;e<C*C;e+=128) coeff[e/C][e%C]=__ldg(p.a+e);
+        __syncthreads();
+#pragma unroll
+        for(int c=0;c<Acc;++c) o[c]*=prefix[t];
+        for(int j=0;j<=t;++j) {
+            const float a=coeff[t][j];
+#pragma unroll
+            for(int c=0;c<Acc;++c) o[c]=fmaf(a,delta[j][part+c*Parts],o[c]);
+        }
+        if(t<count) {
+#pragma unroll
+            for(int c=0;c<Acc;++c) dst[((size_t(seq)*tokens+start+t)*H+head)*D+col0+part+c*Parts]=o[c]*scale;
+        }
+        __syncthreads();
+        for(int e=tid;e<C*C;e+=128) coeff[e/C][e%C]=__ldg(p.decay+e);
+        __syncthreads();
+        // Tiled K^T Delta updates each state element once for this chunk.
+        // Snapshot reconstruction uses the incoming state before overwriting it.
+        constexpr int Rows=TileK*Columns/128;
+        const int key=tid/Columns, col=tid%Columns;
+        for(int k0=0;k0<D;k0+=TileK) {
+            for(int e=tid;e<C*TileK;e+=128) mk[e/TileK][e%TileK]=__ldg(p.k+(e/TileK)*D+k0+e%TileK);
+            __syncthreads();
+            float initial[Rows],s[Rows];
+#pragma unroll
+            for(int r=0;r<Rows;++r) {
+                initial[r]=state[k0+key+r*(128/Columns)][col];
+                s[r]=prefix[count-1]*initial[r];
+            }
+            if constexpr(Keep) {
+                const int first=max(0,tokens-snapshots-start);
+                for(int i=first;i<count;++i) {
+                    float snapshot[Rows];
+#pragma unroll
+                    for(int r=0;r<Rows;++r) snapshot[r]=prefix[i]*initial[r];
+                    for(int j=0;j<=i;++j) {
+                        const float d=coeff[i][j]*delta[j][col];
+#pragma unroll
+                        for(int r=0;r<Rows;++r) snapshot[r]=fmaf(mk[j][key+r*(128/Columns)],d,snapshot[r]);
+                    }
+#pragma unroll
+                    for(int r=0;r<Rows;++r) states[size_t(tokens-1-start-i)*slot_stride+state_base+(col0+col)*D+k0+key+r*(128/Columns)]=snapshot[r];
+                }
+            }
+            for(int j=0;j<count;++j) {
+                const float d=coeff[count-1][j]*delta[j][col];
+#pragma unroll
+                for(int r=0;r<Rows;++r) s[r]=fmaf(mk[j][key+r*(128/Columns)],d,s[r]);
+            }
+#pragma unroll
+            for(int r=0;r<Rows;++r) state[k0+key+r*(128/Columns)][col]=s[r];
+            __syncthreads();
+        }
+    }
+    if constexpr(!Keep) for(int e=tid;e<Columns*D;e+=128)
+        states[state_base+(col0+e/D)*D+e%D]=state[e%D][e/D];
+    ggml_cuda_pdl_lc();
+}
+#endif
