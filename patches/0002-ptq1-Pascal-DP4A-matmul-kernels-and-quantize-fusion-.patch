+}
+
+static float timing(const std::function<void()> & f) {
+    for(int i=0;i<5;++i) f();
+    CUDA_CHECK(cudaDeviceSynchronize());
+    cudaEvent_t start,end; CUDA_CHECK(cudaEventCreate(&start));CUDA_CHECK(cudaEventCreate(&end));
+    CUDA_CHECK(cudaEventRecord(start));
