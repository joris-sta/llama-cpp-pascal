 #include "quantize.cuh"
 #include <cstdint>
+#if !defined(GGML_USE_HIP)
+#include "ptq1-pascal-layout.cuh"
+
+static __global__ void quantize_ptq1_pascal(const float * x, uint32_t * dst,
+        int k, int64_t stride, int pitch) {
+    const int i = blockIdx.x * blockDim.x + threadIdx.x;
+    if (i >= k) return; // K is a multiple of 128: complete warps only.
+    const float v = x[int64_t(blockIdx.y)*stride + i];
+    const float amax = warp_reduce_max<32>(fabsf(v));
+    const float d = amax / 127.0f;
+    const int q = amax == 0.0f ? 0 : int(roundf(v / d));
+    ptq1_pascal_store_q8(dst, pitch, blockIdx.y, i, q, d);
+}
+
+void quantize_ptq1_pascal_cuda(const float * x, uint32_t * dst,
+        int k, int columns, int64_t stride, cudaStream_t stream) {
+    const ggml_cuda_kernel_launch_params launch(dim3((k+255)/256, columns, 1), dim3(256,1,1), 0, stream);
+    ggml_cuda_kernel_launch(quantize_ptq1_pascal, launch, x, dst, k, stride, ptq1_pascal_pitch(k));
+}
+#endif
 
